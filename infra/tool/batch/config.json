{
  "base": "main",
  "branch_prefix": "batch/",
  "docs_root": "",
  "scope": {
    "ignore": [
      "**/.dart_tool/**",
      "**/build/**"
    ],
    "generated": [
      "**/.dart_tool/**",
      "**/build/**"
    ]
  },
  "commit": {
    "types": [],
    "scopes": [],
    "body": []
  },
  "checks": [
    {
      "name": "format",
      "command": [
        "cmd",
        "/c",
        "dart",
        "format",
        "--output=none",
        "--set-exit-if-changed",
        "."
      ],
      "cwd": "app"
    },
    {
      "name": "lint",
      "command": [
        "cmd",
        "/c",
        "flutter",
        "analyze"
      ],
      "cwd": "app"
    },
    {
      "name": "build",
      "command": [
        "cmd",
        "/c",
        "flutter",
        "build",
        "web"
      ],
      "cwd": "app"
    },
    {
      "name": "test",
      "command": [
        "cmd",
        "/c",
        "flutter",
        "test"
      ],
      "cwd": "app"
    }
  ],
  "release_checks": [],
  "pr_create": [
    "gh",
    "pr",
    "create",
    "--base",
    "main",
    "--head",
    "{branch}",
    "--title",
    "{title}",
    "--body-file",
    "{body}"
  ],
  "pr_view": [
    "gh",
    "pr",
    "view",
    "{pr}",
    "--json",
    "body",
    "-q",
    ".body"
  ],
  "translate": [],
  "merge": [
    "gh",
    "pr",
    "merge",
    "{pr}",
    "--squash",
    "--delete-branch"
  ]
}